{
  "name": "fumadocs-vercel",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "postinstall": "fumadocs-mdx",
    "search:build": "node scripts/build-search-index.mjs public/search-index.json",
    "dev": "npm run search:build && next dev",
    "build": "npm run search:build && next build",
    "build:static-docs": "node scripts/build-static-docs.mjs",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "fumadocs-core": "16.14.0",
    "fumadocs-mdx": "15.2.2",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.14.0",
    "katex": "0.16.47",
    "mermaid": "11.17.2",
    "next": "16.3.3",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "remark-mdx": "3.1.1"
  },
  "devDependencies": {
    "@next/env": "16.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "postcss": "8.5.24",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
