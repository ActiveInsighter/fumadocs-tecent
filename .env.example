# Server-only integration settings. Never expose these through NEXT_PUBLIC_*.
POCKETBASE_URL=https://pb.any1.tech
N8N_DOCUMENT_PUBLISH_URL=https://n8n.any1.tech/webhook/anyworkflow-task-enrich
N8N_DOCUMENT_PUBLISH_SECRET=replace-with-a-long-random-value

# Fumadocs signs Blob uploads for n8n; the signer itself is an EdgeOne Function.
FUMADOCS_BLOB_UPLOAD_KEY=replace-with-a-long-random-value
BLOB_SIGNER_URL=https://fumadocs-upload.any1.tech/api/blob/upload-url
BLOB_SIGNER_SECRET=replace-with-a-long-random-value

# Fumadocs proxies downloads through this private EdgeOne Function.
BLOB_DOWNLOAD_GATEWAY_URL=https://fumadocs-upload.any1.tech/download
BLOB_DOWNLOAD_GATEWAY_SECRET=replace-with-a-long-random-value

# Public Algolia search settings. These values are embedded in the browser
# bundle at build time; use a search-only key here, never an admin key.
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=
NEXT_PUBLIC_ALGOLIA_INDEX_NAME=docs

# Server/CI-only setting used by `npm run algolia:sync` to refresh the index.
ALGOLIA_ADMIN_API_KEY=
